from Jade require "crypto_sign/ed25519/amd64/common/64/add4.jinc"
from Jade require "crypto_sign/ed25519/amd64/common/64/cmp4.jinc"
from Jade require "crypto_sign/ed25519/amd64/common/64/sub4.jinc"

require "sqr4.jinc"
require "mul4.jinc"
require "fe25519_freeze.jinc"
require "fe25519_pow2523.jinc"

u64[4] ecd = {0x75EB4DCA135978A3, 0x00700A4D4141D8AB, 0x8CC740797779E898, 0x52036CEE2B6FFE73};
u64[4] sqrtm1 = {0xC4EE1B274A0EA0B0, 0x2F431806AD2FE478, 0x2B4D00993DFBD7A7, 0x2B8324804FC1DF0B};

fn ge25519_unpackneg_vartime(reg ptr u64[16] r, reg ptr u8[32] p) -> reg ptr u64[16], reg u64
{
	reg u64[4] t chk num num_freeze den den2 den4 den6 rx rx_freeze rt sub_x;
	stack u64[4] nums dens den2s r_st;
	stack ptr u64[16] rs;
	reg u8 cmp_8 inv_par par x_par;
	stack u8 pars;
	reg u64 valid subt0 subt1;
	stack u64 valids;
	reg bool cf;
	inline int i;
	
	par = p[31];
	par = par >> 7;
	pars = par;
	
	r[8] = 1;
	r[9] = 0;
	r[10] = 0;
	r[11] = 0;
	for i=0 to 3
	{
		num[i] = p[u64 i];
		r[4+i] = num[i];
	}
	num[3] = p[u64 3];
	num[3] &= 0x7fffffffffffffff;
	r[7] = num[3];
	rs = r;
	
	num = __sqr4_rr(num);
	nums = #copy(num);
	den = __mul4_rsr(ecd, num);
	r = rs;
	num = #copy(nums);
	num = __sub4_rrp(num, r[8:4]);
	nums = #copy(num);
	den = __add4_rrp(den, r[8:4]);
	dens = #copy(den);
	
	/* Computation of sqrt(num/den)
     1.: computation of num^((p-5)/8)*den^((7p-35)/8) = (num*den^7)^((p-5)/8)
  */
	den2 = __sqr4_rr(den);
	den2s = #copy(den2);
	den4 = __sqr4_rr(den2);
	den6 = __mul4_rsr(den2s, den4);
	t = __mul4_rsr(nums, den6);
	t = __mul4_rsr(dens, t);
	
	t = fe25519_pow2523(t);
	
	/* 2. computation of r->x = t * num * den^3
  */
	t = __mul4_rsr(nums, t);
	t = __mul4_rsr(dens, t);
	t = __mul4_rsr(dens, t);
	rx = __mul4_rsr(dens, t);
	
	r = rs;
	for i=0 to 4
	{
		r[i] = rx[i];
	}
	rs = r;
	
	/* 3. Check whether sqrt computation gave correct result, multiply by sqrt(-1) if not:
  */
  
	chk = __sqr4_rr(rx);
	chk = __mul4_rsr(dens, chk);
	chk = __freeze4_rr(chk);
	num_freeze = __freeze4_rs(nums);
	cmp_8 = __cmp4_rr(chk, num_freeze);
	
	r = rs;
	for i=0 to 4
	{
		rx[i] = r[i];
	}
	
	if (cmp_8 != 0){
		rx = __mul4_rsr(sqrtm1, rx);
	}
	
	r = rs;
	for i=0 to 4
	{
		r[i] = rx[i];
	}
	rs = r;
	
	/* 4. Now we have one of the two square roots, except if input was not a square
  */
  
  chk = __sqr4_rr(rx);
  chk = __mul4_rsr(dens, chk);
  
  num_freeze = __freeze4_rs(nums);
	chk = __freeze4_rr(chk);
	cmp_8 = __cmp4_rr(chk, num_freeze);
	
	valid = 0;
	if (cmp_8 != 0){
		valid = -1;
	}
	valids = valid;
	
	/* 5. Choose the desired square root according to parity:
  */
  r = rs;
  for i=0 to 4
	{
		rx[i] = r[i];
	}
  rx_freeze = __freeze4_rr(rx);
  x_par = (8u)rx_freeze[0];
  x_par &= 1;
  
 	inv_par = 1;
 	inv_par = inv_par - pars;
 	
 	if (x_par != inv_par){
		sub_x = #copy(rx);
 		rx[0] = 0;
		rx[1] = 0;
		rx[2] = 0;
		rx[3] = 0;
		
		cf, rx[0] -= sub_x[0];
		cf, rx[1] -= sub_x[1] - cf;
		cf, rx[2] -= sub_x[2] - cf;
		cf, rx[3] -= sub_x[3] - cf;

		subt0 = 0;
		subt1 = 38;
		subt1 = #CMOVcc_64(!cf, subt0, subt1);

		cf, rx[0] -= subt1;
		cf, rx[1] -= subt0 - cf;
		cf, rx[2] -= subt0 - cf;
		cf, rx[3] -= subt0 - cf;
		
		subt0 = #CMOVcc_64(cf, subt1, subt0);

		rx[0] -= subt0;
 	}
 	r = rs;
	for i=0 to 4
	{
		r[i] = rx[i];
	}
	rs = r;
	r = rs;
	r_st[0] = r[4];
	r_st[1] = r[5];
	r_st[2] = r[6];
	r_st[3] = r[7];
	rt = __mul4_rsr(r_st, rx);
	
	r = rs;
	r[12] = rt[0];
	r[13] = rt[1];
	r[14] = rt[2];
	r[15] = rt[3];
	
	valid = valids;
	return r, valid;
}
