require "sc25519_window4.jinc"
require "ge25519_nielsadd2.jinc"
require "choose_t.jinc"
require "init_r.jinc"

fn ge25519_scalarmult_base(reg ptr u64[16] r, reg u64 s0 s1 s2 s3) -> reg ptr u64[16]
{
	stack ptr u64[16] rps;
  stack u8[64] b;
  stack u64[12] t;
  stack u64[19] rs;
  reg u64[4] s rx ry rz;
  reg u8 b_8;
  reg u64 b_arg pos_arg;
  stack u64 i;
  reg u64 ir;
	inline int j;
	
	rps = r;
	
	s[0] = s0;
	s[1] = s1;
	s[2] = s2;
	s[3] = s3;
	
  b = sc25519_window4(s);

	b_8 = b[0];
  b_arg = (64s) b_8;
  
  rs = init_r(b_arg);
  
	
	i = 1;
	ir = i;
  while(ir < 64)
  {
  	b_arg = (64s) b[(int)ir];
  	pos_arg = i;
  	
    t = choose_t(pos_arg, b_arg);
    rs = ge25519_nielsadd2(t, rs);
    
    ir = i;
    ir += 1;
    i = ir;
  }
  
  r = rps;

  rx = __reduce5to4_rs(rs[0:5]);
  for j=0 to 4
  {
  	r[j] = rx[j];
  }
  
  ry = __reduce5to4_rs(rs[5:5]);
  for j=0 to 4
  {
  	r[4 + j] = ry[j];
  }
  
  rz = __reduce5to4_rs(rs[10:5]);
  for j=0 to 4
  {
  	r[8 + j] = rz[j];
  }
  
  for j=0 to 4
  {
  	r[12 + j] = rs[15+j];
  }
  
  return r;
}

inline fn __ge25519_scalarmult_base(reg ptr u64[16] r, reg u64[4] s) -> reg ptr u64[16]
{
	reg u64 s0 s1 s2 s3;
	
	s0 = s[0];
	s1 = s[1];
	s2 = s[2];
	s3 = s[3];
	
	r = ge25519_scalarmult_base(r, s0, s1, s2, s3);
	
	return r;
}
